# EasySearch default excludes — directory names that are skipped anywhere in the
# tree. Items are separated by commas and/or newlines; a line starting with `#`
# is a comment (keep comments comma-free). An item with a slash (`go/pkg/mod`)
# matches that path suffix at any depth, so nested conventions work too.
#
# This file is only written while it does not exist yet, so edit it freely.
# The app rebuilds the index when you change it and restart, or use
# Tools ▸ Rebuild index.

# --- Python ---
.venv,venv,env,.env,virtualenv,__pycache__,__pypackages__,.eggs
.pytest_cache,.mypy_cache,.ruff_cache,.tox,.nox,.ipynb_checkpoints

# --- Node / JavaScript / TypeScript ---
node_modules,.npm,.yarn,.pnpm-store,.bun,.next,.nuxt,.svelte-kit,.turbo
.parcel-cache,.vite,.angular,bower_components

# --- Go ---
go/pkg/mod,pkg/mod,go-build

# --- Rust ---
target

# --- JVM (Java / Kotlin / Scala) and their build tools ---
.gradle,.m2,.ivy2,.kotlin,.bloop,.metals,.sbt

# --- Haskell / Scala ---
dist-newstyle,.stack-work

# --- Ruby / PHP / Elixir / Erlang ---
.bundle,vendor/bundle,deps,_build

# --- Dart / Flutter / Swift ---
.dart_tool,.pub-cache,.swiftpm,Pods

# --- C# / .NET ---
obj
