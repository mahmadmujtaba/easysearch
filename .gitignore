# Everything for Linux — non-essential folders skipped when indexing/searching.
#
# Standard gitignore syntax (patterns apply to every directory below this one).
# The engine honors `.gitignore` (and `.ignore`) files in the searched tree.
#
# To apply the same exclusions to your whole home directory (the default search
# root), copy this file to ~/.gitignore:
#
#     cp .gitignore ~/.gitignore

# VCS internals (never useful to search)
.git/
.svn/
.hg/

# Language/ecosystem build & dependency dirs (high file counts, no search value)
node_modules/
target/
build/
dist/
out/
bin/
obj/
__pycache__/
.pytest_cache/
.mypy_cache/
.tox/
.venv/
venv/
env/
.eggs/
*.egg-info/

# Caches and ephemeral state
.cache/
.Trash/
.local/share/Trash/

# Steam / Proton / Wine prefixes (huge, root-owned subtrees break watchers)
steamapps/compatdata/
steamapps/common/
steamapps/shadercache/
.steam/
.var/app/*/cache/
.wine/
.winetricks/

# Flatpak / Snap / container runtime blobs
.var/app/*/config/
.snap/
containers/libpod/

# Browser caches and profiles (index-heavy, low search value)
.config/google-chrome/
.config/chromium/
.mozilla/firefox/*/cache2/
.cache/mozilla/
.cache/google-chrome/

# Virtualenvs / toolchains / SDKs
.gradle/
.cargo/registry/
.rustup/toolchains/
.npm/
.pnpm-store/
.cache/pip/
.cache/uv/

# Editor/IDE settings
.idea/
.vscode/
*.swp
*~

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Local screenshot scratch (used while developing the UI)
.shots/
